#!/bin/bash
# Trial wrapper: tune the VM without editing vendor source.
#   TS_QEMU_SMP=N        replace every -smp value (DTB generation and real run stay consistent)
#   TS_GUEST_IDLE_POLL=1 append "nohlt" to the guest kernel command line, so idle vCPUs poll
#                        instead of executing WFI. That removes the host sleep/wake round trip
#                        for each guest timer tick, at the cost of one busy host core per vCPU.
#   TS_QEMU_RT=1         load rtboost.dylib so vCPU threads get the macOS real-time policy
#                        (adds -name debug-threads=on so the threads can be found by name).
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
args=()
while (($#)); do
  if [[ "$1" == '-smp' && -n "${TS_QEMU_SMP:-}" ]]; then
    args+=('-smp' "$TS_QEMU_SMP"); shift 2
  elif [[ "$1" == '-append' && "${TS_GUEST_IDLE_POLL:-0}" == 1 ]]; then
    args+=('-append' "$2 nohlt"); shift 2
  else
    args+=("$1"); shift
  fi
done
if [[ "${TS_QEMU_RT:-0}" == 1 ]]; then
  if [[ ! -f "$here/rtboost.dylib" || "$here/rtboost.c" -nt "$here/rtboost.dylib" ]]; then
    clang -O2 -Wall -dynamiclib -o "$here/rtboost.dylib" "$here/rtboost.c"
  fi
  [[ " ${args[*]} " == *" -name "* ]] || args+=('-name' 'mpc-sample,debug-threads=on')
  export DYLD_INSERT_LIBRARIES="$here/rtboost.dylib"
fi
exec /opt/homebrew/bin/qemu-system-aarch64 "${args[@]}"
